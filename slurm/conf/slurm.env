# Everything that is true only on Explorer. Sourced by submit.sh and by both
# job scripts, so the job scripts themselves contain no paths.
PARTITION=courses
ACCOUNT=binf6610.202710
USER=${USER:-$(id -un)}                      # a job may start without $USER set
HOME=${HOME:-$(getent passwd "${USER}" | cut -d: -f6)}
SAMPLESHEET=/courses/BINF6610.202710/data/samplesheet-variant8.csv
PIPELINE_DIR=${HOME}/BINF-6610               # the folder you cloned your repository into
SIF=/scratch/${USER}/containers/variant-call.sif   # the image, fetched by pull.sbatch
RUN_ROOT=${RUN_ROOT:-/scratch/${USER}/w3-run}      # week 3: a NEW folder, so every stage runs in the image
